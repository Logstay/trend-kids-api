DATABASE_URL=postgres://trendkids:trendkids@localhost:5433/trendkids?sslmode=disable
PORT=8080
# ATENÇÃO: com o site na frente (proxy /api), a API enxerga a origem do SITE. Inclua aqui o domínio público do site
# (ex.: https://trendkidsjp.com.br). Se faltar, os POST (pedido, login) recebem 403 sem corpo, enquanto os GET seguem funcionando.
CORS_ORIGINS=http://localhost:3000
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
SESSION_TTL=12h
# false só em desenvolvimento local (http). Em produção deixe true (HTTPS).
COOKIE_SECURE=false
# IPs/CIDRs do servidor Next na frente da API (só deles o X-Forwarded-For vale). Em dev local:
TRUSTED_PROXIES=127.0.0.1,::1
# Frete em centavos (0 = sem frete, até a regra da loja ser definida). Ex.: 1500 = R$ 15,00; grátis a partir de 29900.
SHIPPING_FLAT_CENTS=0
SHIPPING_FREE_ABOVE_CENTS=0
# Logs: LOG_LEVEL = debug|info|warn|error ; LOG_FORMAT = text (terminal) ou json (produção)
LOG_LEVEL=info
LOG_FORMAT=text
