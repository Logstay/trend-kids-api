DATABASE_URL=postgres://trendkids:trendkids@localhost:5433/trendkids?sslmode=disable
PORT=8080
CORS_ORIGINS=http://localhost:3000
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
SESSION_TTL=12h
# false só em desenvolvimento local (http). Em produção deixe true (HTTPS).
COOKIE_SECURE=false
# IPs/CIDRs do servidor Next na frente da API (só deles o X-Forwarded-For vale). Em dev local:
TRUSTED_PROXIES=127.0.0.1,::1
